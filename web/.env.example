# App URL — used in invite emails and absolute redirects
# Production: your public URL
APP_URL=http://localhost:3000

# Auth
AUTH_SECRET=change-me-to-a-random-32-char-string

# First-boot admins (comma-separated, optional ":Name" suffix). They get full access.
ADMIN_EMAILS=alice@example.com:Alice

# Drive folder IDs visible to the "financial-only" group (comma-separated, optional)
LIMITED_GROUP_DRIVE_FOLDER_IDS=

# Document library backend.
# Default: local files from LIBRARY_DIR (the sample library lives in ../corpus/library).
# LIBRARY_DIR=../corpus/library
# Top-level library folders the "financial-only" group may open (local mode)
LIMITED_GROUP_LIBRARY_FOLDERS=Finance

# Google Drive instead of local files (production): set both and the app switches backends.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# DRIVE_ROOT_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J

# Model and prompt
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
# PROMPT_PATH=../PROMPT.md

# Product name shown in the UI and emails
NEXT_PUBLIC_APP_NAME=Data Room

# LangSmith (optional). Set LANGSMITH_PROMPT to pull the rules block from a Hub prompt
# instead of PROMPT.md; set LANGSMITH_SHEET_ROUTER_PROMPT to override the sheet classifier prompt.
LANGSMITH_API_KEY=
LANGSMITH_PROMPT=
LANGSMITH_SHEET_ROUTER_PROMPT=

# Hotjar (optional). Leave empty to disable the snippet.
NEXT_PUBLIC_HOTJAR_ID=

# Redis for sessions, threads, allowlist, caching.
# Empty = in-memory store (local demo only, state is lost on restart).
# Local: make redis, then REDIS_URL=redis://localhost:6379
# Production: your Upstash or managed Redis URL
REDIS_URL=

# Sentry error monitoring (optional, leave empty to disable)
# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Generate at https://sentry.io/settings/auth-tokens/ (needed for source map uploads in CI)
SENTRY_AUTH_TOKEN=


# Sender for OTP and invite emails (Resend)
EMAIL_FROM="Data Room <noreply@example.com>"
